SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=hk

CRON_SECRET=

# Optional: comma-separated ATS board identifiers.
GREENHOUSE_BOARDS=point72,janestreet,jumptrading,towerresearchcapital,imc,flowtraders,ripple,okx

# Example: LEVER_COMPANIES=animocabrands,ambergroup,crypto
LEVER_COMPANIES=animocabrands,ambergroup,crypto

# Example: ASHBY_BOARDS=airwallex,elliptic
ASHBY_BOARDS=airwallex,elliptic

# Optional: one Workday source per item, formatted as Company|host|tenant|site.
# Leave empty to use the bundled finance-focused Workday source list.
WORKDAY_SOURCES=
WORKDAY_SEARCH_TERMS=Hong Kong
WORKDAY_PAGE_LIMIT=4
WORKDAY_DETAIL_LIMIT=90
JOB_FETCH_TIMEOUT_MS=10000

# Optional: comma-separated RSS feeds or article URLs for curated public-account/article sources.
# These should be article feeds or publicly accessible article links you want to treat as a curated input stream.
CURATED_ARTICLE_RSS_FEEDS=
CURATED_ARTICLE_URLS=

# Optional: authenticated wechat2rss query API + biz ids.
# Example base: https://wechat2rss.xlab.app/api/query
WECHAT2RSS_API_BASE=
WECHAT2RSS_TOKEN=
WECHAT_BIZ_IDS=
